# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=123456:AA...
# Кому бот отвечает. Остальных игнорирует. Узнать свой id: @userinfobot
TELEGRAM_ALLOWED_USER_IDS=[111111111]

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# ---------- Bitrix24 (необязательно) ----------
# Оставьте пустым, чтобы работать без CRM: отклики, таблица, напоминания и
# отчёты от Битрикса не зависят. Вписать вебхук можно в любой момент позже.
#
# Входящий вебхук: Разработчикам -> Другое -> Входящий вебхук.
# Права: crm, user, im. Создать его может только администратор портала.
# Слэш на конце обязателен.
BITRIX_WEBHOOK_URL=

# Подбор ведётся Сделками в воронке HR. Номер воронки и коды её стадий
# посмотреть: python -m scripts.setup_bitrix --show-stages
BITRIX_DEAL_CATEGORY_ID=0

# Часть кода стадии после двоеточия: из C7:EXECUTING нужно EXECUTING.
BITRIX_STAGE_NEW=NEW
BITRIX_STAGE_CALLED=PREPARATION
BITRIX_STAGE_TEST_TASK=PREPAYMENT_INVOICE
BITRIX_STAGE_INTERVIEW=EXECUTING
BITRIX_STAGE_INTERN=FINAL_INVOICE
BITRIX_STAGE_RESERVE=1
BITRIX_STAGE_HIRED=WON
BITRIX_STAGE_REJECTED=LOSE

# Коды пользовательских полей сделки. Создаются scripts/setup_bitrix.py.
BITRIX_UF_RESUME_URL=UF_CRM_RESUME_URL
BITRIX_UF_AGE=UF_CRM_AGE
BITRIX_UF_CITY=UF_CRM_CITY
BITRIX_UF_EXPERIENCE=UF_CRM_EXPERIENCE
BITRIX_UF_SALARY=UF_CRM_SALARY
BITRIX_UF_REJECT_REASON=UF_CRM_REJECT_REASON
BITRIX_UF_VACANCY=UF_CRM_VACANCY
BITRIX_UF_BRANCH=UF_CRM_BRANCH

# ---------- hh.ru ----------
# Приложение регистрируется на https://dev.hh.ru/admin
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
HH_REFRESH_TOKEN=
HH_EMPLOYER_ID=
# Забирать отклики только по этим вакансиям. Пусто = по всем активным.
HH_VACANCY_IDS=[]
# Во сколько ходить за откликами. Дважды в день — утром и после обеда:
# отклики копятся часами, разбирать их удобнее пачкой между обзвонами.
# Времена через запятую, сколько угодно. Ещё один опрос идёт при запуске бота
HH_POLL_TIMES=10:00,17:00
# Опрос по интервалу — только если HH_POLL_TIMES пуст
HH_POLL_INTERVAL_MINUTES=15
# Сколько новых кандидатов заводить за один цикл — чтобы первый запуск
# не вывалил в CRM весь накопленный список разом
HH_MAX_NEW_PER_POLL=10
# Граница для самого первого опроса: не забирать отклики старше стольких
# дней. 0 — забирать все. Дальше границей служит время прошлого удачного
# опроса, поэтому выходные с выключенным компьютером ничего не теряют
HH_SKIP_OLDER_THAN_DAYS=0
# Насколько глубоко догонять после долгого перерыва (отпуск, переезд)
HH_CATCH_UP_MAX_DAYS=14
# Отправлять ли отказ на hh.ru вместе со статусом «не подходит».
# Это сообщение соискателю — включайте осознанно
HH_SEND_REJECTION=false
# Текст, который получит соискатель. {name} — его имя.
# Пусто — статус отказа поставим, писать не будем
HH_REJECTION_MESSAGE={name}, здравствуйте! Большое спасибо за интерес к нашей компании! К сожалению, сейчас мы не готовы пригласить вас на следующий этап. Ценим ваше внимание и будем рады взаимодействию в будущем.

# ---------- Google Sheets ----------
GOOGLE_CREDENTIALS_FILE=./service-account.json
GOOGLE_SPREADSHEET_ID=1ReDh9BElb1VkFuV0j0aVCBkR5UmpHOwIIcAR2xjDjac
# Названия листов должны совпадать с ярлычками внизу таблицы, буква в букву
SHEET_TRACKING_NAME=отслеживание проходящих
SHEET_INTERNS_NAME=Стажеры

# ---------- Прочее ----------
DATABASE_URL=sqlite:///./recruiter.db
TIMEZONE=Europe/Moscow
DAILY_REPORT_TIME=19:00
INTERVIEW_CONFIRM_HOURS_BEFORE=24
INTERVIEW_REMINDER_HOURS_BEFORE=1
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
# true = ничего не пишем во внешние системы, только логируем намерение
DRY_RUN=false
LOG_LEVEL=INFO
